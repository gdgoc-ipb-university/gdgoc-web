# Set by `pnpm exec convex dev` (development deployment only).
CONVEX_DEPLOYMENT=dev:your-development-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-development-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-development-deployment.convex.site
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3104
# Optional: Tech League's own origin (production: https://league.gdgocipb.com). Unset, the league is previewed at /league.
# NEXT_PUBLIC_LEAGUE_URL=http://league.lvh.me:3104

# Optional: comma-separated hostnames, without scheme or port, allowed to reach `next dev`
# (e.g. a Cloudflare tunnel). When set, use that URL as NEXT_PUBLIC_SITE_URL and Convex SITE_URL.
# DEV_ALLOWED_ORIGINS=dev.example.com

# Set these on each Convex deployment, not in NEXT_PUBLIC_* variables:
# BETTER_AUTH_SECRET=<unique random secret per deployment>
# SITE_URL=http://127.0.0.1:3104 (production: https://www.gdgocipb.com)
# GOOGLE_CLIENT_ID=<dedicated Google OAuth web client>
# GOOGLE_CLIENT_SECRET=<secret, never commit>
# LEAGUE_URL=<Tech League's origin, as NEXT_PUBLIC_LEAGUE_URL; optional>
# AUTH_COOKIE_DOMAIN=<parent domain both hosts share, e.g. gdgocipb.com; optional, needed for sign-in on the league>
# APPRECIATION_ADMIN_EMAILS=<comma-separated verified Google emails of the owners; they grant other reviewers from /dashboard/anggota>
